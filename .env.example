# Enables the LLM planner. If absent the service still runs, using the
# deterministic keyword fallback, and says so in meta.assumptions.
OPENAI_API_KEY=sk-...

# Planner model. Any chat-completions model supporting strict structured outputs.
OPENAI_MODEL=gpt-5.4-mini

# CORS origins for the demo UI, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000
